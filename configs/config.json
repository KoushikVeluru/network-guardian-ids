{
    "random_seed": 42,
    "device": "cpu",
    "data": {
        "raw_dir": "data/raw/cic-ids2017/MachineLearningCVE",
        "processed_dir": "data/processed",
        "sample_size": 400000,
        "test_size": 0.15,
        "val_size": 0.15
    },
    "features": {
        "drop_columns": ["Flow ID", "Source IP", "Source Port", "Destination IP", "Destination Port", "Protocol", "Timestamp"],
        "label_column": "Label"
    },
    "models": {
        "random_forest": {
            "n_estimators": 200,
            "max_depth": 20,
            "class_weight": "balanced",
            "n_jobs": 4
        },
        "xgboost": {
            "n_estimators": 200,
            "max_depth": 8,
            "learning_rate": 0.1,
            "scale_pos_weight": "auto",
            "tree_method": "hist",
            "n_jobs": 4
        }
    },
    "shap": {
        "subsample_size": 2000,
        "top_features": 10
    }
}
